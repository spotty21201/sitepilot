# ==============================================================================
# SitePilot Environment Configuration (.env.example)
# Note: In Google Cloud production (Cloud Run), authentication uses Application
# Default Credentials (ADC) and IAM service account identity. No API key is required.
# ==============================================================================

# Port configuration (Cloud Run standard is 8080)
PORT=8080

# Google Cloud Project & Location (Required for Vertex AI in GCP)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=asia-southeast2

# Gemini Model Identifier (Compliant with All Things Agentic Hackathon: Gemini 3.5 or newer)
GEMINI_MODEL=gemini-3.7-flash

# Optional Gemini API Key for local development only (fallback mode)
# In production Cloud Run, leave blank to use Vertex AI IAM authentication
GEMINI_API_KEY=
