# ==============================================================================
# SitePilot Environment Configuration (.env.example)
# Note: In Google Cloud production (Cloud Run), authentication uses Application
# Default Credentials (ADC) and IAM service account identity. No API key is required.
# ==============================================================================

# Port configuration (Cloud Run standard is 8080)
PORT=8080

# Google Cloud Project & Location (Required for Vertex AI in GCP)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=asia-southeast2
VERTEX_AI_LOCATION=global

# Configured Gemini model identifier. Official rules require Gemini 3.5 or newer.
GEMINI_MODEL=gemini-3.7-flash

# Taskmaster agent workflow (disabled by default; no live model or cloud calls locally)
TASKMASTER_ALLOW_LIVE_MODEL=false
TASKMASTER_ALLOW_MODEL_REPAIR=false
TASKMASTER_FIRESTORE_ENABLED=false
TASKMASTER_FIRESTORE_COLLECTION=taskmasterRuns
TASKMASTER_FIRESTORE_IDEMPOTENCY_COLLECTION=taskmasterIdempotency
TASKMASTER_CLOUD_TASKS_QUEUE=
TASKMASTER_WORKER_URL=
TASKMASTER_TASK_AUDIENCE=
TASKMASTER_SERVICE_ACCOUNT_EMAIL=
TASKMASTER_WORKER_SECRET=
TASKMASTER_MAX_TOOL_CALLS=16
TASKMASTER_MAX_RETRIES=2
TASKMASTER_MAX_MODEL_CALLS=3
TASKMASTER_MAX_DURATION_MS=30000
TASKMASTER_MAX_OUTPUT_TOKENS=4096
TASKMASTER_MAX_PROVIDER_REQUESTS=8
TASKMASTER_MAX_TOTAL_TOKENS=32768
TASKMASTER_DAILY_RUN_LIMIT=20
TASKMASTER_SESSION_RUN_LIMIT=2
TASKMASTER_COST_CONFIG_VERSION=2026-08-sitepilot-v1
TASKMASTER_COST_INPUT_USD_PER_MILLION=
TASKMASTER_COST_OUTPUT_USD_PER_MILLION=

# Vercel server route → private Cloud Run Taskmaster API (Preview only).
TASKMASTER_API_URL=
TASKMASTER_API_MODE=false
GCP_PROJECT_NUMBER=
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
GCP_WORKLOAD_IDENTITY_PROVIDER_ID=vercel
GCP_VERCEL_API_SERVICE_ACCOUNT=

# Optional Gemini API Key for local development only (fallback mode)
# In production Cloud Run, leave blank to use Vertex AI IAM authentication
GEMINI_API_KEY=
